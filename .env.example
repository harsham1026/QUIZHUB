# QuizHub Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
PORT=5000

# Security Keys
SECRET_KEY=quizhub-ultra-secret-session-key-dev-2026
JWT_SECRET_KEY=quizhub-jwt-secret-token-key-dev-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database (MySQL recommended for production, SQLite supported as fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/quizhub
# DATABASE_URL=sqlite:///quizhub.db

# AI Generator (Gemini API or OpenAI API)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client URLs (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

